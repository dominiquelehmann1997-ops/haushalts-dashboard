DATABASE_URL="file:./dev.db"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_CALENDAR_DOME=
GOOGLE_CALENDAR_EMELY=
GOOGLE_CALENDAR_FAMILY=
GOOGLE_CALENDAR_DOME_DIENSTPLAN=
GOOGLE_CALENDAR_DOME_VEREIN=
GOOGLE_CALENDAR_GEBURTSTAGE=
BRING_EMAIL=
BRING_PASSWORD=
BRING_LIST_UUID=

# Open-Meteo (Phase 5) — free, no API key needed. Set these to your
# household's real coordinates (WGS84 lat/lon); the defaults below are
# Berlin's and only meant as placeholders.
WEATHER_LAT=52.52
WEATHER_LON=13.41

# Pfad zum Obsidian-Rezepte-Vault (lokal gesyncte Kopie), gelesen von "Rezepte einlesen"
RECIPE_VAULT_PATH="C:/Users/<user>/Obsidian/Haushalt/Rezepte"

# Name des Obsidian-Vaults (wie in Obsidian angezeigt), für "Rezept öffnen"-Links
# im Essensplan (obsidian://open?vault=...). Ohne diese Variable werden Gerichte
# nicht verlinkt. Setzt voraus, dass RECIPE_VAULT_PATH direkt unter dem Vault-Root liegt.
OBSIDIAN_VAULT_NAME="Haushalt"

# Ablage der Rezeptbilder, die der Link-Import mitlädt. Muss **außerhalb des
# Repos** liegen — ein Redeploy überschreibt den Repo-Ordner und nähme die
# Bilder mit. Ohne diese Variable bleiben Rezepte schlicht bildlos.
# Ausgeliefert werden die Dateien über /api/recipe-image/<datei>.
RECIPE_IMAGE_DIR="C:/Users/<user>/haushalt-daten/rezeptbilder"

# Zielordner des nächtlichen Rezept-Backups (npm run export:recipes). Jedes
# Rezept wird dort als .md abgelegt — lesbar, nicht zum Zurückspielen; dafür ist
# die datierte prod.db-Kopie daneben da (scripts/tablet-backup.sh).
# Darf der alte Obsidian-Vault-Ordner sein: dann sichert Obsidian Sync die
# Exporte weiter mit, ohne dass die App je von dort liest. Fremde Notizen im
# Ordner bleiben unangetastet. Ohne diese Variable findet kein Export statt.
RECIPE_EXPORT_PATH="C:/Users/<user>/Obsidian/Haushalt/Rezepte"

# Web Push / VAPID (Task 7)
# Generate a fresh key pair with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY and NEXT_PUBLIC_VAPID_PUBLIC_KEY must be identical.
VAPID_PUBLIC_KEY=<generate-with: npx web-push generate-vapid-keys>
VAPID_PRIVATE_KEY=<generate-with: npx web-push generate-vapid-keys>
VAPID_SUBJECT=mailto:your@email.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<same as VAPID_PUBLIC_KEY>
